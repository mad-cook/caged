# --- Public (shipped to the browser) ---------------------------------------
# Helius RPC. Restrict the key to your domain(s) in the Helius dashboard.
NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# "mainnet-beta" | "devnet"
NEXT_PUBLIC_CLUSTER=mainnet-beta
# Deployed holder_locker program id (must match declare_id! in the program).
NEXT_PUBLIC_PROGRAM_ID=65cX8gGch8x4vQvU4gnpPcepwKadDSAtJ4ZgZg3hp61t
# Optional: mint of your own brand token, shown as the featured boosted token.
NEXT_PUBLIC_BRAND_MINT=
# Set your public site origin for social share image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3050

# --- Server only ------------------------------------------------------------
# Same key, used by /api/token/* (Helius DAS metadata). Never exposed.
HELIUS_API_KEY=YOUR_HELIUS_KEY
